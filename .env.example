# Direct Google Analytics Configuration (No Backend Required!)
REACT_APP_GOOGLE_CLIENT_ID=your_oauth_client_id.googleusercontent.com
REACT_APP_GOOGLE_API_KEY=your_api_key_here

# For Universal Analytics (GA3) - if you still use it
REACT_APP_GA_VIEW_ID=your_ga_view_id

# For Google Analytics 4 (Recommended)
REACT_APP_GA4_PROPERTY_ID=your_ga4_property_id

# Legacy - only needed if you want to use backend API instead
# REACT_APP_GA_PROPERTY_ID=your_ga4_property_id_here
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# REACT_APP_API_BASE_URL=http://localhost:8000/api