    },
    {
      id: 7,
      name: "Work 7",
      url: "/assets/works/work7.jpg",
      dateCreated: "2023-08-10",
      dateUpdated: "2023-08-15",
      type: "JPG",
    },
    {
      id: 8,
      name: "Work 8",
      url: "/assets/works/work8.jpg",
      dateCreated: "2023-08-08",
      dateUpdated: "2023-08-12",
      type: "JPG",
    },
    {
      id: 9,
      name: "Work 9",
      url: "/assets/works/work9.jpg",
      dateCreated: "2023-09-10",
      dateUpdated: "2023-09-15",
      type: "JPG",
    },
    {
      id: 10,
      name: "Work 10",
      url: "/assets/works/work10.jpg",
      dateCreated: "2023-09-08",
      dateUpdated: "2023-09-12",
      type: "JPG",
    },
    {
      id: 11,
