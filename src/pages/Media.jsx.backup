                              </p>
                            </div>
                            <p className="text-xs text-gray-500 group-hover:text-gray-200">
                              Created: {image.dateCreated}
                            </p>
                          </div>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                <div className="text-center py-12 text-gray-500">
                  No images found. Try adjusting your search.
                </div>
              )}
            </Tab.Panel>

            {/* Videos Tab Panel */}
            <Tab.Panel>
              {getFilteredMedia(videos).length > 0 ? (
                <div
                  className={
                    viewMode === "grid"
                      ? "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
                      : "grid grid-cols-1 lg:grid-cols-3 gap-6"
                  }
                >
                  {getFilteredMedia(videos).map((video) => (
                    <div key={video.id} className="w-full">
                      {viewMode === "grid" ? (
                        <div className="overflow-hidden workItem">
                          <div className="overflow-hidden relative">
