    },
    {
      id: 13,
      name: "Work 13",
      url: "/assets/works/work13.jpg",
      dateCreated: "2023-11-10",
      dateUpdated: "2023-11-15",
      type: "JPG",
    },
    {
      id: 14,
      name: "Work 14",
      url: "/assets/works/work14.jpg",
      dateCreated: "2023-11-08",
      dateUpdated: "2023-11-12",
      type: "JPG",
    },
    {
      id: 15,
      name: "Work 15",
      url: "/assets/works/work15.jpg",
      dateCreated: "2023-12-10",
      dateUpdated: "2023-12-15",
      type: "JPG",
    },
