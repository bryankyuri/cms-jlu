  // Videos from Home.jsx
  const [videos, setVideos] = useState([
    {
      id: 1,
      name: "Banner Video",
      url: "https://cdn.jasonbradley.co/pic/ff41675d.mp4",
      thumbnail: "/assets/works/work1.jpg", // Using work1 as thumbnail
      dateCreated: "2023-01-05",
      dateUpdated: "2023-01-07",
      type: "MP4",
    },
    {
      id: 2,
      name: "PILLOW WALK - ALDO",
      url: "https://cdn.jasonbradley.co/pic/6e1d7d78%20(1).mp4",
      thumbnail: "/assets/works/work2.jpg", // Using work2 as thumbnail
      dateCreated: "2023-02-10",
